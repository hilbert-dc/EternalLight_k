{
  "name": "novel-codex",
  "productName": "Novel Codex",
  "version": "0.1.0",
  "private": true,
  "author": "Eternal Light",
  "description": "A Codex-inspired creative workspace for long-form fiction.",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "build:native-engine": "npm --prefix ../agent-engine run build:native",
    "build:story-runtime": "cargo build --manifest-path native/Cargo.toml --bins",
    "test:codex-tool-schema": "node --test electron/tests/codex-tool-schema.test.mjs",
    "test:story-core": "cargo test --manifest-path native/Cargo.toml",
    "bench:long-work": "cargo run --release --manifest-path native/Cargo.toml -p novel-codex-story-core --example long_work_benchmark",
    "bench:context": "cargo run --release --manifest-path native/Cargo.toml -p novel-codex-story-runtime --example context_pack_benchmark",
    "bench:passages": "cargo run --release --manifest-path native/Cargo.toml -p novel-codex-story-core --example passage_benchmark",
    "evaluate:story": "cargo run --release --manifest-path native/Cargo.toml -p novel-codex-story-core --example story_retrieval_evaluation --",
    "predev": "npm run build:native-engine && npm run build:story-runtime",
    "pretest:agent": "npm run build:native-engine && npm run build:story-runtime",
    "prestage:release-runtime": "npm run build:native-engine",
    "precertify:model": "npm run build:native-engine",
    "prequalify:model": "npm run build:native-engine",
    "dev": "node electron/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "repo:check": "node scripts/verify-fork-boundary.mjs",
    "repo:check:strict": "node scripts/verify-fork-boundary.mjs --strict",
    "sync:upstream": "node scripts/sync-upstream.mjs",
    "candidate:validate": "node scripts/upstream-candidate-release.mjs validate",
    "candidate:promote": "node scripts/upstream-candidate-release.mjs promote",
    "candidate:rollback": "node scripts/upstream-candidate-release.mjs rollback",
    "stage:release-runtime": "node scripts/stage-release-runtime.mjs",
    "verify:release-runtime": "node scripts/verify-release-runtime.mjs",
    "build:codex-runtime": "node scripts/build-codex-runtime.mjs",
    "refresh:model-policy": "node scripts/refresh-model-policy.mjs",
    "qualify:model": "node scripts/qualify-model.mjs",
    "probe:live-story": "node scripts/probe-live-story.mjs",
    "probe:live-revision": "node scripts/probe-live-revision.mjs",
    "certify:model": "node scripts/certify-model.mjs",
    "evaluate:model": "node scripts/evaluate-model.mjs",
    "package:dir": "node scripts/package-release.mjs dir",
    "package:mac": "node scripts/package-release.mjs mac",
    "package:win": "node scripts/package-release.mjs win",
    "verify": "npm run repo:check && npm run build && npm run test:story-core && npm run test:runtime && npm run test:domain-task && npm run test:engine && npm --prefix ../agent-engine run test:delegation-integration && npm run test:release-gate && npm run test:live-probes && npm run test:agent && npm run test:creative-journey && npm run test:desktop-journey && npm run test:condition-evaluation && npm run test:chapter-rebind && npm run test:ui && npm run test:action-permission && npm run test:execution-scope && npm run test:revision-outcome",
    "test:revision-outcome": "node --test --test-concurrency=1 electron/tests/revision-outcome-followup.test.mjs electron/tests/revision-outcome-handoff.test.mjs electron/tests/revision-outcome-approval.test.mjs electron/tests/revision-outcome-ui.test.mjs electron/tests/revision-decision-handlers.test.mjs electron/tests/revision-decision-ui.test.mjs electron/tests/revision-repair-handlers.test.mjs electron/tests/revision-repair-ui.test.mjs",
    "test:execution-scope": "node --test --test-concurrency=1 electron/tests/execution-scope.test.mjs electron/tests/execution-scope-ui.test.mjs",
    "test:action-permission": "node --test --test-concurrency=1 electron/tests/action-permission.test.mjs electron/tests/action-permission-ui.test.mjs electron/tests/task-provider-budget.test.mjs electron/tests/initial-budget-confirmation.test.mjs electron/tests/work-budget-confirmation.test.mjs electron/tests/planning-review-budget.test.mjs electron/tests/planning-review-resumption.test.mjs",
    "pretest:condition-evaluation": "npm run build:story-runtime",
    "test:condition-evaluation": "node --test --test-concurrency=1 electron/tests/condition-evaluation.test.mjs electron/tests/condition-evaluation-ui.test.mjs electron/tests/condition-runtime-integration.test.mjs",
    "test:generation-replan": "node --test --test-concurrency=1 electron/tests/generation-replan.test.mjs electron/tests/generation-replan-ui.test.mjs",
    "test:creative-journey": "node --test --test-concurrency=1 electron/tests/engine-startup.test.mjs electron/tests/runtime-readiness.test.mjs electron/tests/mcp-startup.test.mjs electron/tests/scoped-revision-engine-integration.test.mjs electron/tests/engine-budget-terminal.integration.test.mjs",
    "pretest:desktop-journey": "npm run build",
    "test:desktop-journey": "node --test electron/tests/production-desktop-integration.test.mjs",
    "test:live-probes": "node --test --test-concurrency=1 scripts/tests/probe-live-revision.test.mjs scripts/tests/probe-revision-scope.integration.test.mjs",
    "pretest:chapter-rebind": "npm run build:story-runtime",
    "test:chapter-rebind": "node --test --test-concurrency=1 electron/tests/chapter-rebind.test.mjs electron/tests/chapter-rebind-ui.test.mjs electron/tests/rebind-runtime-integration.test.mjs",
    "start": "electron electron/main.mjs",
    "test:runtime": "cargo test --manifest-path native/Cargo.toml",
    "test:domain-task": "node --test electron/tests/domain-task-prompt.test.mjs",
    "test:engine": "npm --prefix ../agent-engine test",
    "test:release-gate": "node --test scripts/tests/upstream-candidate-release.test.mjs scripts/tests/model-cli-options.test.mjs scripts/tests/certification-publication.test.mjs",
    "test:ui": "node --test --test-concurrency=1 electron/tests/action-proposal-ui.test.mjs electron/tests/agent-events.test.mjs electron/tests/chapter-rebind-ui.test.mjs electron/tests/commitment-ui.test.mjs electron/tests/creative-workspace-ui.test.mjs electron/tests/export-dialog.test.mjs electron/tests/identity-decision-ui.test.mjs electron/tests/impact-analysis-ui.test.mjs electron/tests/local-metrics-ui.test.mjs electron/tests/markdown-content.test.mjs electron/tests/modeling-context-ui.test.mjs electron/tests/property-rules-ui.test.mjs electron/tests/proposal-set-ui.test.mjs electron/tests/task-final-reply-ui.test.mjs electron/tests/workspace-diagnostics-ui.test.mjs electron/tests/revision-repair-ui.test.mjs",
    "test:agent": "node --test --test-concurrency=1 electron/tests/knowledge-schema-integration.test.mjs electron/tests/codex-tool-schema.test.mjs electron/tests/advisory-sessions.test.mjs electron/tests/agent-configuration.test.mjs electron/tests/agent-final-reply.test.mjs electron/tests/chapter-rebind.test.mjs electron/tests/codex-adapter.test.mjs electron/tests/codex-engine-integration.test.mjs electron/tests/codex-protocol-integration.test.mjs electron/tests/codex-runtime.test.mjs electron/tests/conformance-mcp.test.mjs electron/tests/creative-product-logic.test.mjs electron/tests/creative-task-contract.test.mjs electron/tests/development-credentials.test.mjs electron/tests/fork-boundary.test.mjs electron/tests/generation-duration.test.mjs electron/tests/generation-feedback.test.mjs electron/tests/hypothesis.test.mjs electron/tests/impact-analysis.test.mjs electron/tests/model-certification.test.mjs electron/tests/modeling-consumer.test.mjs electron/tests/navigation-policy.test.mjs electron/tests/passage-engine-integration.test.mjs electron/tests/property-rule-input-engine.test.mjs electron/tests/proposal-set.test.mjs electron/tests/recovery-reconciliation.test.mjs electron/tests/release-runtime.test.mjs electron/tests/scoped-revision-engine-integration.test.mjs electron/tests/task-lifecycle.test.mjs electron/tests/webcontents-safety.test.mjs electron/tests/workflow-handoff.test.mjs"
  },
  "dependencies": {
    "@eternallight/agent-engine": "file:../agent-engine",
    "@vitejs/plugin-react": "^4.4.1",
    "js-tiktoken": "1.0.21",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "concurrently": "^9.1.2",
    "electron": "^38.8.6",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.12",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  },
  "allowScripts": {
    "electron@38.8.6": true
  },
  "build": {
    "appId": "com.eternallight.novelcodex",
    "productName": "Novel Codex",
    "artifactName": "Novel-Codex-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "codex-runtime/model-catalog.json",
      "codex-runtime/model-certifications.json",
      "codex-runtime/supported-cli.json",
      "shared/**/*",
      "scripts/build-provenance.mjs",
      "node_modules/@eternallight/agent-engine/**/*",
      "!node_modules/@eternallight/agent-engine/target/**/*",
      "package.json",
      "!electron/tests/**/*"
    ],
    "asarUnpack": [
      "node_modules/@eternallight/agent-engine/src/**/*",
      "node_modules/@eternallight/agent-engine/native/bin/**/*"
    ],
    "extraResources": [
      {
        "from": ".release/resources",
        "to": ".",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "target": ["dmg", "zip"]
    },
    "win": {
      "icon": "assets/icon.png",
      "target": ["nsis", "zip"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
