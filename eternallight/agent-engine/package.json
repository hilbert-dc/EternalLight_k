{
  "name": "@eternallight/agent-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.mjs",
    "./qualification/codex-conformance-runner": "./qualification/codex-conformance-runner.mjs",
    "./qualification/codex-core-integration-runner": "./qualification/codex-core-integration-runner.mjs",
    "./qualification/delegation-proof": "./qualification/delegation-proof.mjs",
    "./qualification/conformance-mcp": "./qualification/conformance-mcp.mjs",
    "./qualification/core-conformance-mcp": "./qualification/core-conformance-mcp.mjs",
    "./qualification/evaluate-model": "./qualification/evaluate-model.mjs",
    "./test-support": "./src/testing/index.mjs"
  },
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "pretest": "npm run build:native",
    "pretest:delegation-integration": "npm run build:native",
    "pretest:output-admission-integration": "npm run build:native",
    "evaluate:model": "node qualification/evaluate-model.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:delegation-integration": "node --test tests/responses-delegation.integration.mjs",
    "test:output-admission-integration": "node --test tests/responses-output-admission.integration.mjs",
    "pretest:portable-discovery": "npm run build:native",
    "test:portable-discovery": "cargo test --manifest-path native/engine-core/Cargo.toml --test tool_discovery_tests && node --test tests/portable-discovery.test.mjs",
    "pretest:mcp-output-policy": "npm run build:native",
    "test:mcp-output-policy": "cargo test --manifest-path native/engine-core/Cargo.toml --lib config::tests::mcp_ && node --test --test-name-pattern='MCP per-tool output' tests/contracts.test.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
